# Copy to .env (gitignored) and fill in what you have. Restart the office after editing.
# Keys here are used by any floor whose provider matches and that has no key saved in the app.

# Google Gemini via an AI Studio key (https://aistudio.google.com/apikey). Provider: "Google Gemini (AI Studio key)".
GEMINI_API_KEY=

# Google Vertex AI = Gemini billed to a Google Cloud project (Cloud credits apply). Provider: "Google Vertex AI".
# Path to an authorized_user sign-in file (e.g. gcloud's ~/.config/gcloud/application_default_credentials.json
# after `gcloud auth application-default login`) or a service-account key JSON.
VERTEX_CREDENTIALS=
VERTEX_PROJECT=            # optional if the credentials file has project_id / quota_project_id
VERTEX_LOCATION=global

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
